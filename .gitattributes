# Shell scripts: git archive on Windows (core.autocrlf=true) must export LF
# blobs, not CRLF — broken shebang causes container exec failures.
*.sh text eol=lf

# Same failure mode as above, but for extensionless scripts under
# ansible/files/ that *.sh doesn't match (2026-09-08: qlsm-network-rules-apply
# shipped with a CRLF shebang via qlsm-sync.sh's `git archive` on this Windows
# checkout, breaking `qlsm-network-rules.service` on every managed host).
ansible/files/qlsm-network-rules-apply text eol=lf
ansible/files/update_ql_workshops.sh text eol=lf
ansible/files/ql-watchdog/*.py text eol=lf

# Plugin source of truth: ql-assets/data/minqlx-plugins/ (the pool ansible
# deploys to every host) is mirrored onto configs/presets/_builtin/default/scripts/
# (the builtin default ConfigPreset). Both trees must use the same line
# endings or a sync pass reintroduces a CRLF/LF-only diff that masks/
# duplicates real content changes. Normalize to LF regardless of platform or
# per-user core.autocrlf.
ql-assets/data/minqlx-plugins/**/*.py text eol=lf
ql-assets/data/minqlx-plugins/**/*.ql-plugin.json text eol=lf
configs/presets/_builtin/default/scripts/**/*.py text eol=lf
configs/presets/_builtin/default/scripts/**/*.ql-plugin.json text eol=lf

# Git hooks are extensionless, so *.sh above doesn't match them. A CRLF
# shebang makes them silently not run (or fail) on Linux checkouts.
scripts/git-hooks/post-commit text eol=lf
scripts/git-hooks/post-merge text eol=lf
