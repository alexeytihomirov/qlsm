# qlmatch-packer ships to Linux hosts (rsync from the container checkout);
# keep its sources LF for determinism (Node tolerates CRLF, but the vendored
# qldemo copy must diff cleanly against ql-stream-tools' own LF blobs).
ql-assets/data/qlmatch-packer/**/*.js text eol=lf
ql-assets/data/qlmatch-packer/**/*.mjs text eol=lf
ql-assets/data/qlmatch-packer/**/*.json text eol=lf
ql-assets/data/qlmatch-packer/**/*.md text eol=lf
ql-assets/data/qlmatch-packer/**/*.txt text eol=lf
