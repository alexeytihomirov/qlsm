@@ -1332,6 +1332,34 @@
     Py_RETURN_TRUE;
 }
 
+/*
+* ================================================================
+*                       get_player_weapon_stats
+* ================================================================
+*/
+
+static PyObject* PyMinqlx_GetPlayerWeaponStats(PyObject* self, PyObject* args) {
+    int client_id, weapon;
+    if (!PyArg_ParseTuple(args, "ii:get_player_weapon_stats", &client_id, &weapon))
+        return NULL;
+    else if (client_id < 0 || client_id >= sv_maxclients->integer) {
+        PyErr_Format(PyExc_ValueError,
+                     "client_id needs to be a number from 0 to %d.",
+                     sv_maxclients->integer);
+        return NULL;
+    }
+    else if (weapon < 0 || weapon >= 16) {
+        PyErr_SetString(PyExc_ValueError, "weapon needs to be a number from 0 to 15.");
+        return NULL;
+    }
+    else if (!g_entities[client_id].client)
+        Py_RETURN_NONE;
+
+    return Py_BuildValue("(ii)",
+                         g_entities[client_id].client->expandedStats.shotsFired[weapon],
+                         g_entities[client_id].client->expandedStats.shotsHit[weapon]);
+}
